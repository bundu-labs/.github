// markdownlint-cli2 config — relaxed defaults for bundu-labs/.github.
//
// Mirrors nyuchi/.github with MD060 disabled because Prettier's
// table-column alignment doesn't satisfy the rule's "consistent
// style" check once cell widths differ.
//
// See https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
{
  "default": true,
  "MD013": false,
  "MD033": false,
  "MD041": false,
  "MD040": false,
  "MD024": { "siblings_only": true },
  "MD007": { "indent": 2 },
  "MD060": false,
}
